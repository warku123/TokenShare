# CRE workflow secrets — NEVER commit the real .env
# Copy to `.env` (same directory) and fill in real values.
#
# CRE_ETH_PRIVATE_KEY: 64-char hex WITHOUT 0x prefix. Used by the simulator
# to sign broadcast transactions (`--broadcast`). Use a disposable testnet
# key funded with a little Monad testnet MON — never a production key.
CRE_ETH_PRIVATE_KEY=YOUR_64_CHARACTER_PRIVATE_KEY_HERE_WITHOUT_0X

# Bearer token the workflow sends to the relay receipt endpoint via
# Confidential HTTP (referenced in secrets.yaml as receipts_bearer).
# A dummy value is fine if the relay does not enforce auth.
RECEIPTS_BEARER_ALL=dummy-bearer-token
